# ============================================================
# MONEY LEDGER — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Database (PostgreSQL) ---
# Render PostgreSQL: Get this from your Render PostgreSQL service dashboard
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/money_ledger?schema=public"

# --- Redis ---
# Render Redis / Upstash Redis: Get this from your Redis service dashboard
# Format: redis://default:password@hostname:port
# For TLS (Upstash): rediss://default:password@hostname:port
REDIS_URL="redis://localhost:6379"

# --- Kafka (optional - app works without Kafka in degraded mode) ---
# Upstash Kafka / Confluent Cloud
# Format: broker1:port,broker2:port
KAFKA_BROKERS=""
KAFKA_CLIENT_ID="money-ledger"

# Upstash Kafka SASL credentials (if using Upstash)
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""

# --- JWT Secrets (MUST be changed in production — use 32+ char random strings) ---
JWT_ACCESS_SECRET="change-me-to-a-secure-32-char-secret-key"
JWT_REFRESH_SECRET="change-me-to-a-different-32-char-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Bcrypt ---
BCRYPT_ROUNDS="10"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_SECONDS="60"
TRANSFER_RATE_LIMIT="5"
MONEY_MOVEMENT_RATE_LIMIT="30"

# --- SMTP Email (optional — app works without email) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Money Ledger <no-reply@money-ledger.app>"

# --- Node Environment ---
NODE_ENV="production"

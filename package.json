    "test:integration": "npx tsx --test tests/integration/api.integration.test.ts",
    "test:concurrency": "npx tsx --test tests/concurrency/concurrency.test.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",

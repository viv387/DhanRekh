generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  TRANSFER
  CONVERSION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  RETRYING
}

enum ScheduledFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id               String   @id @default(uuid()) @map("user_id") @db.Uuid
  username         String   @unique
  email            String   @unique
  phone            String   @unique
  passwordHash     String   @map("password_hash")
  isEmailVerified  Boolean  @default(false) @map("is_email_verified")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?  @map("two_factor_secret")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  wallet            Wallet?
  idempotencyKeys   IdempotencyKey[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  conversions       CurrencyConversion[]
  scheduledPayments ScheduledPayment[]
  fraudAlerts       FraudAlert[]
  passwordResets    PasswordResetToken[]

  @@map("users")
}

model Wallet {
  id            String       @id @default(uuid()) @map("wallet_id") @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  accountNumber String       @unique @map("account_number")
  balance       Decimal      @default(0) @db.Decimal(18, 2)
  currency      String       @default("USD")
  status        WalletStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentTransactions     Transaction[]        @relation("SenderTransactions")
  receivedTransactions Transaction[]        @relation("ReceiverTransactions")
  ledgerEntries        Ledger[]
  conversions          CurrencyConversion[]
  scheduledPayments    ScheduledPayment[]

  @@index([status])
  @@map("wallets")
}

model Transaction {
  id               String            @id @default(uuid()) @map("transaction_id") @db.Uuid
  senderWalletId   String?           @map("sender_wallet_id") @db.Uuid
  receiverWalletId String?           @map("receiver_wallet_id") @db.Uuid
  amount           Decimal           @db.Decimal(18, 2)
  transactionType  TransactionType   @map("transaction_type")
  status           TransactionStatus @default(PENDING)
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")

  senderWallet   Wallet?         @relation("SenderTransactions", fields: [senderWalletId], references: [id], onDelete: SetNull)
  receiverWallet Wallet?         @relation("ReceiverTransactions", fields: [receiverWalletId], references: [id], onDelete: SetNull)
  ledgerEntries  Ledger[]
  idempotencyKey IdempotencyKey?
  fraudAlerts    FraudAlert[]

  @@index([senderWalletId])
  @@index([receiverWalletId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model Ledger {
  id            String          @id @default(uuid()) @map("ledger_id") @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  walletId      String          @map("wallet_id") @db.Uuid
  entryType     LedgerEntryType @map("entry_type")
  amount        Decimal         @db.Decimal(18, 2)
  balanceBefore Decimal         @map("balance_before") @db.Decimal(18, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(18, 2)
  createdAt     DateTime        @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([walletId])
  @@map("ledger")
}

model Outbox {
  id            String       @id @default(uuid()) @map("outbox_id") @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       String       @db.Text
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([status])
  @@index([createdAt])
  @@map("outbox")
}

model DeadLetterMessage {
  id            String    @id @default(uuid()) @map("dlq_id") @db.Uuid
  topic         String
  consumerGroup String    @map("consumer_group")
  payload       String    @db.Text
  errorReason   String    @map("error_reason")
  status        String    @default("FAILED")
  createdAt     DateTime  @default(now()) @map("created_at")
  replayedAt    DateTime? @map("replayed_at")

  @@index([status])
  @@index([createdAt])
  @@map("dead_letter_messages")
}

model CurrencyConversion {
  id           String   @id @default(uuid()) @map("conversion_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  walletId     String   @map("wallet_id") @db.Uuid
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  fromAmount   Decimal  @map("from_amount") @db.Decimal(18, 2)
  toAmount     Decimal  @map("to_amount") @db.Decimal(18, 2)
  rate         Decimal  @db.Decimal(18, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@map("currency_conversions")
}

model ScheduledPayment {
  id                    String             @id @default(uuid()) @map("scheduled_id") @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  senderWalletId        String             @map("sender_wallet_id") @db.Uuid
  receiverAccountNumber String             @map("receiver_account_number")
  amount                Decimal            @db.Decimal(18, 2)
  currency              String             @default("USD")
  frequency             ScheduledFrequency @default(ONCE)
  nextRunAt             DateTime           @map("next_run_at")
  status                String             @default("ACTIVE")
  createdAt             DateTime           @default(now()) @map("created_at")

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderWallet Wallet @relation(fields: [senderWalletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunAt])
  @@index([status])
  @@map("scheduled_payments")
}

model FraudAlert {
  id              String   @id @default(uuid()) @map("alert_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  transactionId   String?  @map("transaction_id") @db.Uuid
  riskScore       Int      @map("risk_score")
  confidenceScore Int      @default(90) @map("confidence_score")
  reasons         String   @db.Text
  status          String   @default("FLAGGED")
  createdAt       DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([riskScore])
  @@index([status])
  @@map("fraud_alerts")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @map("reset_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @map("key_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  transactionId  String?  @unique @map("transaction_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("idempotency_keys")
}

model AuditLog {
  id        String   @id @default(uuid()) @map("audit_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id           String   @id @default(uuid()) @map("token_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Notification {
  id        String   @id @default(uuid()) @map("notification_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

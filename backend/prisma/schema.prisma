generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
}

enum WalletStatus {
	ACTIVE
	SUSPENDED
	CLOSED
}

enum TransactionType {
	DEPOSIT
	WITHDRAW
	TRANSFER
}

enum TransactionStatus {
	PENDING
	COMPLETED
	FAILED
	REVERSED
}

enum LedgerEntryType {
	DEBIT
	CREDIT
}

model User {
	id              String           @id @default(uuid()) @db.Uuid @map("user_id")
	username        String           @unique
	email           String           @unique
	phone           String           @unique
	passwordHash    String           @map("password_hash")
	createdAt       DateTime         @default(now()) @map("created_at")
	updatedAt       DateTime         @updatedAt @map("updated_at")

	wallet          Wallet?
	idempotencyKeys IdempotencyKey[]
	auditLogs       AuditLog[]
	refreshTokens   RefreshToken[]
	notifications   Notification[]

	@@map("users")
}

model Wallet {
	id              String           @id @default(uuid()) @db.Uuid @map("wallet_id")
	userId          String           @unique @db.Uuid @map("user_id")
	accountNumber   String           @unique @map("account_number")
	balance         Decimal          @default(0) @db.Decimal(18, 2)
	currency        String           @default("USD")
	status          WalletStatus     @default(ACTIVE)
	createdAt       DateTime         @default(now()) @map("created_at")

	user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
	sentTransactions Transaction[]   @relation("SenderTransactions")
	receivedTransactions Transaction[] @relation("ReceiverTransactions")
	ledgerEntries   Ledger[]

	@@map("wallets")
	@@index([status])
}

model Transaction {
	id              String             @id @default(uuid()) @db.Uuid @map("transaction_id")
	senderWalletId  String?            @db.Uuid @map("sender_wallet_id")
	receiverWalletId String?           @db.Uuid @map("receiver_wallet_id")
	amount          Decimal            @db.Decimal(18, 2)
	transactionType TransactionType    @map("transaction_type")
	status          TransactionStatus  @default(PENDING)
	description     String?
	createdAt       DateTime           @default(now()) @map("created_at")

	senderWallet    Wallet?            @relation("SenderTransactions", fields: [senderWalletId], references: [id], onDelete: SetNull)
	receiverWallet  Wallet?            @relation("ReceiverTransactions", fields: [receiverWalletId], references: [id], onDelete: SetNull)
	ledgerEntries   Ledger[]
	idempotencyKey  IdempotencyKey?

	@@map("transactions")
	@@index([senderWalletId])
	@@index([receiverWalletId])
	@@index([status])
	@@index([createdAt])
}

model Ledger {
	id              String         @id @default(uuid()) @db.Uuid @map("ledger_id")
	transactionId   String         @db.Uuid @map("transaction_id")
	walletId        String         @db.Uuid @map("wallet_id")
	entryType       LedgerEntryType @map("entry_type")
	amount          Decimal        @db.Decimal(18, 2)
	balanceBefore   Decimal        @db.Decimal(18, 2) @map("balance_before")
	balanceAfter    Decimal        @db.Decimal(18, 2) @map("balance_after")
	createdAt       DateTime       @default(now()) @map("created_at")

	transaction     Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
	wallet          Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)

	@@map("ledger")
	@@index([transactionId])
	@@index([walletId])
}

model IdempotencyKey {
	id              String        @id @default(uuid()) @db.Uuid @map("key_id")
	userId          String        @db.Uuid @map("user_id")
	transactionId   String?       @unique @db.Uuid @map("transaction_id")
	idempotencyKey  String        @unique @map("idempotency_key")
	createdAt       DateTime      @default(now()) @map("created_at")

	user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
	transaction     Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

	@@map("idempotency_keys")
	@@index([userId])
}

model AuditLog {
	id              String        @id @default(uuid()) @db.Uuid @map("audit_id")
	userId          String        @db.Uuid @map("user_id")
	action          String
	ipAddress       String?       @map("ip_address")
	userAgent       String?       @map("user_agent")
	createdAt       DateTime      @default(now()) @map("created_at")

	user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@map("audit_logs")
	@@index([userId])
	@@index([createdAt])
}

model RefreshToken {
	id              String        @id @default(uuid()) @db.Uuid @map("token_id")
	userId          String        @db.Uuid @map("user_id")
	refreshToken    String        @unique @map("refresh_token")
	expiresAt       DateTime      @map("expires_at")
	createdAt       DateTime      @default(now()) @map("created_at")

	user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@map("refresh_tokens")
	@@index([userId])
	@@index([expiresAt])
}

model Notification {
	id              String        @id @default(uuid()) @db.Uuid @map("notification_id")
	userId          String        @db.Uuid @map("user_id")
	title           String
	message         String
	isRead          Boolean       @default(false) @map("is_read")
	createdAt       DateTime      @default(now()) @map("created_at")

	user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@map("notifications")
	@@index([userId])
	@@index([isRead])
	@@index([createdAt])
}
